{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron-warm",
      "schedule": "*/30 * * * *"
    },
    {
      "path": "/api/cron-prices",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron-yesterday",
      "schedule": "30 9 * * *"
    },
    {
      "path": "/api/cron-map-layers",
      "schedule": "20 5 * * *"
    },
    {
      "path": "/api/cron-gas",
      "schedule": "5 * * * *"
    },
    {
      "path": "/api/cron-constraints?bundle=breakdown",
      "schedule": "40 4 * * *"
    },
    {
      "path": "/api/cron-constraints?bundle=day-ahead",
      "schedule": "40 16 * * 1-5"
    },
    {
      "path": "/api/cron-directory",
      "schedule": "45 6 * * 1"
    },
    {
      "path": "/api/cron-tec",
      "schedule": "15 6 * * 1,4"
    },
    {
      "path": "/api/cron-northern-ireland",
      "schedule": "15 * * * *"
    },
    {
      "path": "/api/cron-power-cuts",
      "schedule": "*/15 * * * *"
    }
  ],
  "functions": {
    "src/app/api/cron-northern-ireland/route.ts": {
      "regions": ["lhr1"]
    },
    "src/app/api/cron-power-cuts/route.ts": {
      "regions": ["lhr1"]
    }
  }
}
