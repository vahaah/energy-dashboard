{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron-prices",
      "schedule": "30 */6 * * *"
    },
    {
      "path": "/api/cron-yesterday",
      "schedule": "30 9 * * *"
    }
  ],
  "routes": [
    {
      "src": "^/api/(dashboard|prices|look-ahead|snapshots|generation|interconnectors)$",
      "headers": {
        "Vary": "Accept-Encoding"
      },
      "continue": true,
      "override": true
    }
  ]
}
