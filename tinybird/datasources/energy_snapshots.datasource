TOKEN ingest_token APPEND

SCHEMA >
    `timestamp` DateTime `json:$.timestamp`,
    `carbon_intensity` Nullable(Float32) `json:$.carbon_intensity`,
    `carbon_forecast` Nullable(Float32) `json:$.carbon_forecast`,
    `carbon_index` String `json:$.carbon_index`,
    `demand_mw` Nullable(Float32) `json:$.demand_mw`,
    `price_gbp_mwh` Nullable(Float32) `json:$.price_gbp_mwh`,
    `price_mid_gbp_mwh` Nullable(Float32) `json:$.price_mid_gbp_mwh`,
    `mid_volume_mwh` Nullable(Float32) `json:$.mid_volume_mwh`,
    `gen_gas_pct` Nullable(Float32) `json:$.gen_gas_pct`,
    `gen_coal_pct` Nullable(Float32) `json:$.gen_coal_pct`,
    `gen_nuclear_pct` Nullable(Float32) `json:$.gen_nuclear_pct`,
    `gen_wind_pct` Nullable(Float32) `json:$.gen_wind_pct`,
    `gen_solar_pct` Nullable(Float32) `json:$.gen_solar_pct`,
    `gen_hydro_pct` Nullable(Float32) `json:$.gen_hydro_pct`,
    `gen_biomass_pct` Nullable(Float32) `json:$.gen_biomass_pct`,
    `gen_imports_pct` Nullable(Float32) `json:$.gen_imports_pct`,
    `gen_other_pct` Nullable(Float32) `json:$.gen_other_pct`,
    `gen_gas_mw` Nullable(Float32) `json:$.gen_gas_mw`,
    `gen_coal_mw` Nullable(Float32) `json:$.gen_coal_mw`,
    `gen_nuclear_mw` Nullable(Float32) `json:$.gen_nuclear_mw`,
    `gen_wind_mw` Nullable(Float32) `json:$.gen_wind_mw`,
    `gen_solar_mw` Nullable(Float32) `json:$.gen_solar_mw`,
    `gen_hydro_mw` Nullable(Float32) `json:$.gen_hydro_mw`,
    `gen_biomass_mw` Nullable(Float32) `json:$.gen_biomass_mw`,
    `gen_other_mw` Nullable(Float32) `json:$.gen_other_mw`,
    `gen_pumped_mw` Nullable(Float32) `json:$.gen_pumped_mw`,
    `gen_battery_mw` Nullable(Float32) `json:$.gen_battery_mw`

ENGINE "ReplacingMergeTree"
ENGINE_SORTING_KEY "timestamp"
