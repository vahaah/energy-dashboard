DESCRIPTION >
    Returns interconnector flow data (fuel_type starting with 'INT') from generation_5min.
    Positive = import to GB, negative = export from GB.

TOKEN dashboard_read READ

NODE endpoint
SQL >
    %
    SELECT
        g.timestamp,
        g.fuel_type AS interconnector,
        any(g.generation_mw) AS generation_mw,
        CASE
            WHEN any(g.generation_mw) >= 0 THEN 'import'
            ELSE 'export'
        END AS direction
    FROM generation_5min AS g
    WHERE startsWith(lower(g.fuel_type), 'int')
    {% if defined(start) and defined(end) %}
        AND g.timestamp BETWEEN {{DateTime(start)}} AND {{DateTime(end)}}
    {% else %}
        AND g.timestamp = (
            SELECT max(latest.timestamp)
            FROM generation_5min AS latest
            WHERE startsWith(lower(latest.fuel_type), 'int')
        )
    {% end %}
    GROUP BY g.timestamp, g.fuel_type
    ORDER BY timestamp ASC, interconnector ASC

TYPE endpoint
