DESCRIPTION >
    Latest generation reading per fuel type, not a single shared timestamp.
    Ignores future timestamps so NESO day-ahead forecasts cannot become "now".

TOKEN dashboard_read READ

NODE endpoint
SQL >
    SELECT
        g.fuel_type,
        max(g.timestamp) AS timestamp,
        argMax(g.generation_mw, g.timestamp) AS generation_mw,
        argMax(g.source, g.timestamp) AS source
    FROM generation_5min AS g
    WHERE g.timestamp <= now()
    GROUP BY g.fuel_type
    ORDER BY generation_mw DESC

TYPE endpoint
