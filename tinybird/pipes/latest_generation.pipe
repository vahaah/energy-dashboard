DESCRIPTION >
    Latest generation reading per fuel type, not a single shared timestamp.
    Embedded solar/wind update on a coarser cadence than FUELINST and must
    still appear in headline mix and domestic generation totals.

TOKEN dashboard_read READ

NODE endpoint
SQL >
    SELECT
        fuel_type,
        max(timestamp) AS timestamp,
        argMax(generation_mw, timestamp) AS generation_mw,
        argMax(source, timestamp) AS source
    FROM generation_5min
    GROUP BY fuel_type
    ORDER BY generation_mw DESC

TYPE endpoint
