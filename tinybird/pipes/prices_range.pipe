TOKEN dashboard_read READ

DESCRIPTION >
    Returns commodity price history between start and end dates.
    Optional commodity filter. FINAL forces ReplacingMergeTree to keep the
    last ingested row per (date, commodity).

NODE endpoint
SQL >
    %
    SELECT
        p.date,
        p.commodity,
        p.price,
        p.currency,
        p.unit
    FROM commodity_prices AS p FINAL
    WHERE p.date >= {{Date(start, '2026-01-01')}}
      AND p.date <= {{Date(end, '2099-01-01')}}
      {% if defined(commodity) %}
        AND p.commodity = {{String(commodity, '')}}
      {% end %}
    ORDER BY p.date ASC, p.commodity ASC

TYPE endpoint
