TOKEN dashboard_read READ

DESCRIPTION >
    Returns the latest price for each commodity.
    FINAL collapses unmerged ReplacingMergeTree versions so the last ingest
    for a date wins before picking max(date) per commodity.

NODE endpoint
SQL >
    SELECT
        p.commodity,
        argMax(p.price, p.date) AS price,
        argMax(p.currency, p.date) AS currency,
        argMax(p.unit, p.date) AS unit,
        max(p.date) AS date
    FROM commodity_prices AS p FINAL
    GROUP BY p.commodity
    ORDER BY commodity ASC

TYPE endpoint
