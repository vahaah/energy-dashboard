# Copy to .env.local. Values below are placeholders. Do not commit real tokens.

# ─── Tinybird ────────────────────────────────────────────────
# Workspace admin token: cron ingest. Read token: dashboard_read pipe queries.
# There is no fallback from the read token to the admin token.
# After `cd tinybird && tb --cloud deploy`, list tokens with `tb --cloud token ls`.
TINYBIRD_URL=https://api.eu-central-1.aws.tinybird.co
TINYBIRD_TOKEN=your_admin_token_here
TINYBIRD_READ_TOKEN=your_dashboard_read_token_here

# ─── EIA (US Energy Information Administration) ──────────────
# Free key from https://www.eia.gov/opendata/ — required for EIA ingest.
# DEMO_KEY is not used.
EIA_API_KEY=your_eia_api_key_here

# ─── Vercel Cron ─────────────────────────────────────────────
# Required. Cron routes fail closed when this is unset.
# Vercel sends it as Authorization: Bearer <secret>.
CRON_SECRET=your_random_secret_here

# ─── Upstash Redis (optional cache, slot lock, warmed envelopes) ─
# REST URL must be https:// (not rediss://). If both pairs are unset,
# local ingest still runs and public reads go to Tinybird directly.
# Marketplace Redis may set KV_REST_API_URL and KV_REST_API_TOKEN instead.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ─── Vercel Blob ─────────────────────────────────────────────
# Public tiles store: basemap upload, gas, constraints, map flows, postcodes.
# Never log the token. The basemap script exits when this is empty.
BLOB_READ_WRITE_TOKEN=

# Private store for the ISD directory snapshot. Not the public tiles token.
DIRECTORY_BLOB_STORE_ID=
DIRECTORY_BLOB_READ_WRITE_TOKEN=

# ─── IndexNow (optional, post-deploy submit only) ────────────
# Must match the public key file in public/. The key is public by design.
# The submit script redacts it in logs. Leave unset for local development.
INDEXNOW_KEY=

# ─── Chrome WebMCP origin trial (optional) ───────────────────
# Public page token, not a credential. Read at build time and trimmed.
# Unset or empty emits no origin-trial meta tag. Do not commit a value.
# WEBMCP_ORIGIN_TRIAL_TOKEN=

# ─── Basemap rebuild (optional, not used by the app or by CI) ─
# Local MBTiles path. Reused only when its edition matches the product API.
BASEMAP_MBTILES=

# ─── Unused optional keys (ingest disabled; safe if absent) ──
OIL_PRICE_API_KEY=your_oilpriceapi_key_here
FRED_API_KEY=your_fred_api_key_here
