# ─── Tinybird ────────────────────────────────────────────────
# Get these from https://app.tinybird.co → your workspace → Tokens
# After deploying Tinybird resources: cd tinybird && tb --cloud deploy
# Then list tokens: tb --cloud token ls
TINYBIRD_URL=https://api.eu-central-1.aws.tinybird.co
TINYBIRD_TOKEN=your_admin_token_here
TINYBIRD_READ_TOKEN=your_dashboard_read_token_here

# ─── EIA (US Energy Information Administration) ──────────────
# Register at https://www.eia.gov/opendata/ — free, instant
# Required for EIA ingest. DEMO_KEY is no longer used (it time-outs the cron).
EIA_API_KEY=your_eia_api_key_here

# ─── Vercel Cron Secret ─────────────────────────────────────
# Set in Vercel dashboard → Settings → Environment Variables
# Vercel automatically sends this as Authorization: Bearer <secret>
CRON_SECRET=your_random_secret_here

# ─── Upstash Redis (optional read-through cache) ────────────────
# Provision via the Vercel Marketplace. If either var is absent, or Redis
# errors, the app falls back to the existing Next.js fetch / unstable_cache.
# Do not commit real tokens.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ─── Unused optional keys (ingest disabled everywhere; safe if absent) ──
# Not read by /api/cron-prices or scripts/backfill.ts. Stored Tinybird rows stay.
OIL_PRICE_API_KEY=your_oilpriceapi_key_here
FRED_API_KEY=your_fred_api_key_here
